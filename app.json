{
  "expo": {
    "name": "Manora Live",
    "slug": "manora-live",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "manoralive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "fr.manora.live"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffaf1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.manora.live",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffaf1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Manora Live utilise la caméra pour prendre des photos : à la borne, ou pour partager les vôtres dans la galerie.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Manora Live utilise la caméra pour prendre des photos : à la borne, ou pour partager les vôtres dans la galerie.",
          "photosPermission": "Manora Live accède à vos photos pour que vous puissiez en partager dans la galerie de l’événement.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Manora Live accède à vos photos pour que vous puissiez en partager dans la galerie de l’événement.",
          "savePhotosPermission": "Manora Live enregistre les photos de l’événement dans votre galerie.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#b83a22"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mana_uca",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbb0f34e-eb72-4be3-a061-cd90f60a4065"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cbb0f34e-eb72-4be3-a061-cd90f60a4065",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
