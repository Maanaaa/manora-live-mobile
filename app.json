{
  "expo": {
    "name": "Manora Live",
    "slug": "manora-live",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "manoralive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "fr.manora.live"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffaf1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.manora.live"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffaf1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Manora Live utilise la caméra pour prendre des photos : à la borne, ou pour partager les vôtres dans la galerie.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Manora Live utilise la caméra pour prendre des photos : à la borne, ou pour partager les vôtres dans la galerie.",
          "photosPermission": "Manora Live accède à vos photos pour que vous puissiez en partager dans la galerie de l’événement.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Manora Live accède à vos photos pour que vous puissiez en partager dans la galerie de l’événement.",
          "savePhotosPermission": "Manora Live enregistre les photos de l’événement dans votre galerie.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
